<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ipz.bills.RegisterController"
      alignment="CENTER"
      spacing="15"
      stylesheets="@styles.css">

    <Label text="Registration"
           styleClass="title"/>

    <TextField
            fx:id="loginField"
            promptText="Username"
            maxWidth="250"/>

    <PasswordField
            fx:id="passwordField"
            promptText="Password"
            maxWidth="250"/>

    <PasswordField
            fx:id="confirmPasswordField"
            promptText="Confirm Password"
            maxWidth="250"/>

    <Button
            text="Register"
            prefWidth="170"
            onAction="#handleRegister"/>

</VBox>